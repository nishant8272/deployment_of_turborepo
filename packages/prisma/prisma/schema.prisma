
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(uuid())
  name         String
  email        String        @unique
  passwordHash String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  boardMembers BoardMember[]
  cardMembers  CardMember[]
  comments     Comment[]
  createdCards Card[]        @relation("CardCreator")
  boards       Board[]       @relation("BoardOwner")
}

model Board {
  id          String        @id @default(uuid())
  title       String
  description String?
  ownerId     String
  owner       User          @relation("BoardOwner", fields: [ownerId], references: [id])
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  members     BoardMember[]
  lists       List[]
}

enum BoardRole {
  OWNER
  ADMIN
  MEMBER
}

model BoardMember {
  id        String    @id @default(uuid())
  boardId   String
  userId    String
  role      BoardRole @default(MEMBER)
  createdAt DateTime  @default(now())
  board     Board     @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([boardId, userId])
}

model List {
  id        String   @id @default(uuid())
  boardId   String
  title     String
  position  Float    // Use float for easy reordering (e.g. inserting between 1 and 2 = 1.5)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards     Card[]
}

model Card {
  id          String       @id @default(uuid())
  listId      String
  title       String
  description String?      @db.Text
  position    Float
  dueDate     DateTime?
  createdById String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  list        List         @relation(fields: [listId], references: [id], onDelete: Cascade)
  createdBy   User         @relation("CardCreator", fields: [createdById], references: [id])
  members     CardMember[]
  comments    Comment[]
}

model CardMember {
  id      String @id @default(uuid())
  cardId  String
  userId  String
  card    Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([cardId, userId])
}

model Comment {
  id        String   @id @default(uuid())
  cardId    String
  userId    String
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}